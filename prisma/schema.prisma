generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals Rental[]
}

model Material {
  id               String   @id @default(cuid())
  name             String
  totalUnits       Int      @default(0)
  availableUnits   Int      @default(0)
  dailyRentalRate  Decimal  @db.Decimal(10, 2)
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rentals Rental[]
}

enum RentalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Rental {
  id              String       @id @default(cuid())
  customerId      String
  materialId      String
  quantity        Int
  startDate       DateTime
  endDate         DateTime?
  dailyRentalRate Decimal      @db.Decimal(10, 2)
  totalAmount     Decimal?      @db.Decimal(10, 2)
  status          RentalStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customer        Customer     @relation(fields: [customerId], references: [id])
  material        Material     @relation(fields: [materialId], references: [id])
  @@index([customerId])
  @@index([materialId])
  @@index([status])
}