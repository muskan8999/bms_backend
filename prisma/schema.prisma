generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals Rental[]
}

model Material {
  id              String   @id @default(cuid())
  name            String
  totalUnits      Int      @default(0)
  availableUnits  Int      @default(0)
  dailyRentalRate Decimal  @db.Decimal(10, 2)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentalItems RentalItem[]
}

enum RentalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Rental {
  id          String       @id @default(cuid())
  customerId  String
  startDate   DateTime
  endDate     DateTime?
  totalAmount Decimal?     @db.Decimal(10, 2)
  status      RentalStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  items    RentalItem[]
  returns  RentalReturn[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
}

model RentalItem {
  id              String  @id @default(cuid())
  rentalId        String
  materialId      String
  quantity        Int
  returnedQuantity Int     @default(0)
  dailyRentalRate Decimal @db.Decimal(10, 2)

  rental   Rental             @relation(fields: [rentalId], references: [id])
  material Material           @relation(fields: [materialId], references: [id])
  returns  RentalReturnItem[]

  @@index([rentalId])
  @@index([materialId])
}

model RentalReturn {
  id         String   @id @default(cuid())
  rentalId   String
  returnDate DateTime

  damageCharges     Decimal @default(0) @db.Decimal(10, 2)
  additionalCharges Decimal @default(0) @db.Decimal(10, 2)
  discount          Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rental Rental             @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  items  RentalReturnItem[]

  @@index([rentalId])
  @@index([returnDate])
}

model RentalReturnItem {
  id           String @id @default(cuid())
  returnId     String
  rentalItemId String
  quantity     Int

  createdAt DateTime @default(now())

  rentalReturn RentalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  rentalItem   RentalItem   @relation(fields: [rentalItemId], references: [id])

  @@index([returnId])
  @@index([rentalItemId])
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  rentalId    String
  amount      Decimal       @db.Decimal(10, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  reference   String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([paymentDate])
}